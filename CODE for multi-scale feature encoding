if __name__ == "__main__":
    # Simulate a batch of 4 thin-section pairs (3 channels, 224x224 pixels)
    batch_size = 4
    mock_ppl = torch.randn(batch_size, 3, 224, 224)
    mock_xpl = torch.randn(batch_size, 3, 224, 224)
    
    encoder = RockMultiFeatureEncoder(embed_dim=512, final_embedding_dim=256)
    encoder.eval()
    
    with torch.no_grad():
        embeddings = encoder(mock_ppl, mock_xpl)
        
    print(f"Generated thin-section embedding shape: {embeddings.shape}")
    # Output matches: [4, 256] -> Perfect for distance calculations or classification headers
